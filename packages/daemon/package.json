{
  "name": "@tokenfall/daemon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "start": "bun src/main.ts",
    "dev": "bun --watch src/main.ts --dev",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@tokenfall/data": "workspace:*",
    "@tokenfall/protocol": "workspace:*"
  }
}
